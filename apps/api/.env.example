NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizpilot_ai?schema=public
JWT_SECRET=change-this-secret-in-production
JWT_ISSUER=bizpilot-ai
JWT_AUDIENCE=bizpilot-ai-api
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
SESSION_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=bizpilot_refresh_token
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Production Metrics (backend only)
METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=
METRICS_DEFAULT_METRICS_ENABLED=true
METRICS_PREFIX=bizpilot

SHUTDOWN_TIMEOUT_MS=10000
STORAGE_PROVIDER=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_UPLOAD_EXPIRES_SECONDS=600
R2_PRESIGNED_DOWNLOAD_EXPIRES_SECONDS=300

# Shared Redis Infrastructure (backend only)
REDIS_ENABLED=false
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_HEALTH_CACHE_TTL_MS=30000
REDIS_MAX_RECONNECT_ATTEMPTS=3
REDIS_KEY_PREFIX=bizpilot
REDIS_REQUIRED_IN_PRODUCTION=false

# AI Assistant (backend only)
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=llama3.2
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONTEXT_CHARS=16000
AI_MAX_OUTPUT_CHARS=6000
AI_RATE_LIMIT_STORE=memory
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_MAX_ORGANIZATION_REQUESTS=200
AI_HEALTH_CACHE_TTL_MS=60000
AI_HEALTH_TIMEOUT_MS=3000



