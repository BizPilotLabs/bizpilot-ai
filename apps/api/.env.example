NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizpilot_ai?schema=public
JWT_SECRET=change-this-secret-in-production
JWT_ISSUER=bizpilot-ai
JWT_AUDIENCE=bizpilot-ai-api
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
SESSION_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=bizpilot_refresh_token
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
STORAGE_PROVIDER=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_UPLOAD_EXPIRES_SECONDS=600
R2_PRESIGNED_DOWNLOAD_EXPIRES_SECONDS=300
