{
    "$schema":  "https://turbo.build/schema.json",
    "tasks":  {
                  "build":  {
                                "dependsOn":  [
                                                  "^build"
                                              ],
                                "outputs":  [
                                                "dist/**",
                                                ".next/**"
                                            ]
                            },
                  "dev":  {
                              "cache":  false,
                              "persistent":  true
                          },
                  "lint":  {

                           },
                  "test":  {
                               "dependsOn":  [
                                                 "^test"
                                             ],
                               "outputs":  [
                                               "coverage/**"
                                           ]
                           },
                  "format":  {

                             },
                  "test:run":  {
                                   "dependsOn":  [
                                                     "^test:run"
                                                 ],
                                   "outputs":  [
                                                   "coverage/**"
                                               ]
                               },
                  "test:watch":  {
                                     "cache":  false,
                                     "persistent":  true
                                 },
                  "test:coverage":  {
                                        "dependsOn":  [
                                                          "^test:coverage"
                                                      ],
                                        "outputs":  [
                                                        "coverage/**"
                                                    ]
                                    }
              }
}

